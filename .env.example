# WebsiteBanja AI — Production Environment Configuration Template
# Copy this file to .env.local and populate with your actual service credentials.
# NEVER commit .env.local or any file containing real keys/secrets to Git.

# -----------------------------------------------------------------------------
# DATABASE: Azure Database for PostgreSQL Flexible Server
# -----------------------------------------------------------------------------
# Active Provider: "azure" (locked - Supabase DB has been fully decommissioned)
DB_PROVIDER=azure

# Azure PostgreSQL Connection Strings:
# Option A: Full connection URL
DATABASE_URL=postgresql://<admin-user>:<password>@<server-name>.postgres.database.azure.com:5432/<database>?sslmode=require
DIRECT_DATABASE_URL=postgresql://<admin-user>:<password>@<server-name>.postgres.database.azure.com:5432/<database>?sslmode=require

# Option B: Individual connection parameters
AZURE_DB_HOST=websitebanja-db.postgres.database.azure.com
AZURE_DB_PORT=5432
AZURE_DB_USER=websitebanjaadmin
AZURE_DB_PASSWORD=your-azure-db-password
AZURE_DB_NAME=postgres

# Pool settings
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONN_TIMEOUT_MS=5000
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# STORAGE: Azure Blob Storage
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=azure
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account-name>;AccountKey=<account-key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=<account-name>
AZURE_STORAGE_ACCOUNT_KEY=<account-key>
AZURE_STORAGE_CONTAINER=project-workspaces

# -----------------------------------------------------------------------------
# AUTHENTICATION: Supabase Auth (Identity & Sessions ONLY)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------------
# AI ENGINE & MODEL PROVIDERS
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_GENERATION_MODEL=gpt-5.6-luna
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...

# -----------------------------------------------------------------------------
# RATE LIMITING & CACHE: Upstash Redis
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://websitebanja.com
ADMIN_EMAILS=websitebanja@gmail.com,safalyadav0001@gmail.com,safalyadav07@gmail.com,safalyadavvv@gmail.com,admin@websitebanja.com
ADMIN_USER_IDS=a0d29ad3-219e-4ff7-9ef1-f5ae0c5d5d85,cceafe47-8178-43d9-9520-fe1d2931a29b,d1df43b9-aeb1-4fc3-9e19-090c888fc91c,badf862a-a035-43ea-9fc6-5a4358a98a3c
NODE_ENV=production

# -----------------------------------------------------------------------------
# REAL-WORLD INTEGRATIONS (Phase 16)
# -----------------------------------------------------------------------------
# Google Places API (New) — Text Search Provider
GOOGLE_PLACES_API_KEY=AIzaSyYourRestrictedGooglePlacesApiKeyHere

# Gmail API OAuth 2.0 Credentials (websitebanja@gmail.com)
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-yourClientSecretHere
GMAIL_REDIRECT_URI=https://websitebanja-app.salmondesert-9c3e03bc.centralindia.azurecontainerapps.io/api/integrations/gmail/callback
GMAIL_SENDER_EMAIL=websitebanja@gmail.com
# Production server refresh token (stored via secretref or secure env in Azure)
GMAIL_REFRESH_TOKEN=1//your-gmail-oauth-refresh-token

# WhatsApp Status: Strictly DISABLED (Dedicated business line required; zero personal numbers)
# WHATSAPP_ACCESS_TOKEN=disabled
# WHATSAPP_PHONE_NUMBER_ID=disabled

# -----------------------------------------------------------------------------
# AUTOMATION PIPELINE & GUARDRAILS (Phases 12–16)
# -----------------------------------------------------------------------------
WEBSITEBANJA_AUTOMATION_SECRET=your-secure-internal-automation-secret
AUTO_SEND_ENABLED=false
COMMUNICATION_DRY_RUN=false

# -----------------------------------------------------------------------------
# BILLING & PAYMENTS: Razorpay LIVE Mode
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
CRON_SECRET=...
