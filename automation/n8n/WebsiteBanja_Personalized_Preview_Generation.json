{
  "id": "WebsiteBanja_Personalized_Preview",
  "name": "WebsiteBanja — Personalized Preview Generation",
  "nodes": [
    {
      "parameters": {},
      "id": "e440c440-4004-4004-8004-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "leadId",
              "value": "lead_cc4f59e3d5e5"
            },
            {
              "name": "auditId",
              "value": ""
            }
          ]
        },
        "options": {}
      },
      "id": "e440c440-4004-4004-8004-000000000002",
      "name": "Phase 8 Lead Handoff Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Format request payload for WebsiteBanja Personalized Preview API\nconst payload = {\n  leadId: item.leadId || 'lead_cc4f59e3d5e5',\n  auditId: item.auditId || undefined\n};\n\nreturn [{ json: payload }];"
      },
      "id": "e440c440-4004-4004-8004-000000000003",
      "name": "Prepare Preview Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/automation/generate-personalized-preview",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-automation-secret",
              "value": "={{ $env.WEBSITEBANJA_AUTOMATION_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "e440c440-4004-4004-8004-000000000004",
      "name": "HTTP Request → Generate Preview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.success }}",
              "value2": true
            }
          ]
        }
      },
      "id": "e440c440-4004-4004-8004-000000000005",
      "name": "Preview Generation Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\n\n// Format structured handoff for Phase 11 Personalized Outreach\nconst handoff = {\n  status: 'preview_generated_ready_for_outreach',\n  leadId: res.leadId,\n  auditId: res.auditId,\n  preview: {\n    previewId: res.preview ? res.preview.id : '',\n    slug: res.preview ? res.preview.slug : '',\n    url: res.preview ? res.preview.url : '',\n    qualityScore: res.preview ? res.preview.qualityScore : 0,\n    designArchetype: res.preview ? res.preview.designArchetype : '',\n    sectionCount: res.preview ? res.preview.sectionCount : 0,\n    imageManifest: res.preview ? res.preview.imageManifest : []\n  },\n  business: res.business || {},\n  outreachContext: res.outreachContext || {},\n  handoffPhase: 'phase11_personalized_outreach'\n};\n\nreturn [{ json: handoff }];"
      },
      "id": "e440c440-4004-4004-8004-000000000006",
      "name": "Format Phase 11 Outreach Handoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        200
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "generation_failed"
            },
            {
              "name": "errorCode",
              "value": "={{ $json.error ? $json.error.code : 'GENERATION_FAILED' }}"
            },
            {
              "name": "errorMessage",
              "value": "={{ $json.error ? $json.error.message : 'Personalized preview generation failed' }}"
            },
            {
              "name": "details",
              "value": "={{ $json.error && $json.error.details ? JSON.stringify($json.error.details) : '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e440c440-4004-4004-8004-000000000007",
      "name": "Handle Preview Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1340,
        420
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Phase 8 Lead Handoff Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Phase 8 Lead Handoff Input": {
      "main": [
        [
          {
            "node": "Prepare Preview Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Preview Request": {
      "main": [
        [
          {
            "node": "HTTP Request → Generate Preview",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request → Generate Preview": {
      "main": [
        [
          {
            "node": "Preview Generation Succeeded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preview Generation Succeeded?": {
      "main": [
        [
          {
            "node": "Format Phase 11 Outreach Handoff",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Handle Preview Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
